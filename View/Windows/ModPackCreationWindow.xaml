<hc:Window x:Class="DoomPacker.View.Windows.ModPackCreationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:DoomPacker.ViewModel.Windows"
        mc:Ignorable="d"
        Height="700" Width="600"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource RegionBrush}"
        FontSize="16"
        Title="Create new Modpack">
    <hc:Window.DataContext>
        <vm:ModPackCreationWindowViewModel/>
    </hc:Window.DataContext>
    
    <Grid>
        <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="{StaticResource RegionBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,2">
            <StackPanel
                Orientation="Horizontal">
                <hc:ImageSelector
                    x:Name="ImageSelector"
                    Height="164"
                    Width="164"
                    Margin="10">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger
                            EventName="ImageSelected"> <!-- SourceUpdated не связался почему-то -->
                            <!-- 
                                Фотка обновится сама, но чтобы запомнить что вы выбрали, 
                                можно привязать вторую команду, которая рулит VM
                            -->
                            <hc:InvokeCommandAction
                                Command="{Binding RememberImagePathCommand}"
                                CommandParameter="{Binding ElementName=ImageSelector, Path=Uri}"/>
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </hc:ImageSelector>
                <StackPanel
                    Margin="10"
                    Width="390">
                    <TextBlock 
                        Text="Title"
                        Foreground="White"/>
                    <TextBox 
                        Text="{Binding Title}"/>
                    <TextBlock
                        Text="Description"
                        Foreground="White"/>
                    <TextBox 
                        Height="90"
                        VerticalScrollBarVisibility="Visible"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Text="{Binding Description}">
                    </TextBox>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border
            Background="{StaticResource SecondaryRegionBrush}"
            Margin="24, 220, 24, 44"
            CornerRadius="16">
            <Grid
                Margin="16">
                <TextBlock
                    Text="Mods folder"
                    Foreground="White"
                    VerticalAlignment="Top"
                    Margin="80,0,0,0"/>
                <TextBlock
                    Text="Mods in Modpack"
                    Foreground="White"
                    VerticalAlignment="Top"
                    Margin="335,0,0,0"/>
                <Border
                    Margin="0,24,0,0"
                    HorizontalAlignment="Left"
                    Width="250"
                    Background="{StaticResource RegionBrush}"
                    CornerRadius="8"
                    BorderBrush="{StaticResource SecondaryBorderBrush}"
                    BorderThickness="2">
                    <ListBox
                        Margin="4"
                        BorderThickness="0"
                        ItemsSource="{Binding ModsInFolder}"
                        SelectedItem="{Binding SelectedItemFolder, Mode=TwoWay}">
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="MouseDoubleClick">
                                <hc:InvokeCommandAction
                                    Command="{Binding FolderDoubleClickCommand}"
                                    CommandParameter="{Binding SelectedItemFolder}"/>
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </ListBox>
                </Border>
                <Border
                    Margin="0,24,0,0"
                    HorizontalAlignment="Right"
                    Width="250"
                    Background="{StaticResource RegionBrush}"
                    CornerRadius="8"
                    BorderBrush="{StaticResource SecondaryBorderBrush}"
                    BorderThickness="2">
                    <ListBox
                        Margin="4"
                        BorderThickness="0"
                        ItemsSource="{Binding ModsInModPack}"
                        SelectedItem="{Binding SelectedItemPack, Mode=TwoWay}">
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="MouseDoubleClick">
                                <hc:InvokeCommandAction
                                    Command="{Binding PackDoubleClickCommand}"
                                    CommandParameter="{Binding SelectedItemPack}"/>         
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </ListBox>
                </Border>
            </Grid>
        </Border>
        <Button
            Style="{StaticResource ButtonPrimary}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="4"
            Content="Save"
            FontSize="16"
            Height="36"
            Command="{Binding ViewModelStateCommand}"/>
    </Grid>
</hc:Window>
